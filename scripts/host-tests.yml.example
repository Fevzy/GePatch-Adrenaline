name: GePatch host tests
on: [push, pull_request, workflow_dispatch]
jobs:
  host:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.x'
      - name: Compile and run synthetic GE regression tests (x64)
        shell: cmd
        run: scripts\test_gepatch.cmd
